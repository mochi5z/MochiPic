<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/button_layout_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/list_touch_target_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/small_margin"
    android:paddingEnd="@dimen/activity_margin">

    <ImageView
        android:id="@+id/button_layout_drag"
        android:layout_width="@dimen/list_touch_target_min"
        android:layout_height="@dimen/list_touch_target_min"
        android:contentDescription="@string/mochipic_button_layout_drag"
        android:padding="@dimen/normal_margin"
        android:src="@drawable/ic_drag_handle_vector" />

    <ImageView
        android:id="@+id/button_layout_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/activity_margin"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/button_layout_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/normal_text_size" />

    <TextView
        android:id="@+id/button_layout_slot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/small_margin"
        android:textSize="@dimen/smaller_text_size" />

</LinearLayout>
